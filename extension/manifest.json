{
  "manifest_version": 3,
  "name": "Pluck",
  "version": "1.0.0",
  "description": "Click any page, pluck the video — yt-dlp + ffmpeg motorlu indirici.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pluck",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab"],
  "host_permissions": ["http://127.0.0.1/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "pluck@local.app",
      "strict_min_version": "115.0"
    }
  }
}
